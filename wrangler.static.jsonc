{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deanverse-ai",
  "main": "workers/static.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
