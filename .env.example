# Everything here is optional. With none of it set the app still runs: the
# workspace lives on the device and the assistant speaks with the browser's own
# voice. Copy to .env.local and fill in what you want.

# ---------------------------------------------------------------- sync
# From your Supabase project settings → API. Run supabase/schema.sql once, then
# sign in from More → Settings. Sync runs automatically from then on.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------- language + voice
# One key powers both the reply polish (/api/ai) and the spoken voice
# (/api/speech). Both features detect the key on their own — no extra flags.
AI_API_KEY=

# Override only if you are not using OpenAI.
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TTS_MODEL=gpt-4o-mini-tts
# AI_TTS_VOICE=alloy
